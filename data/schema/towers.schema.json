{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emplacement definitions",
  "type": "object",
  "required": [
    "schema",
    "towers"
  ],
  "properties": {
    "schema": {
      "const": "towers"
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cost",
          "draw_mw",
          "damage",
          "range",
          "fire_interval",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "integer",
            "minimum": 0
          },
          "draw_mw": {
            "type": "number",
            "minimum": 0,
            "description": "continuous MW while online. the number that matters."
          },
          "damage": {
            "type": "number",
            "minimum": 0
          },
          "range": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "in tiles"
          },
          "fire_interval": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "seconds"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "ground",
                "air",
                "shielded"
              ]
            }
          },
          "splash": {
            "type": "number",
            "minimum": 0
          },
          "unlocked_at": {
            "type": "string",
            "pattern": "^anchor-\\d{2}$"
          },
          "note": {
            "type": "string"
          },
          "effect": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "non-damage role. 'slow' scales enemy speed in range; 'reveal' makes air units targetable; 'damp' suppresses that fraction of a covered unit's bus drain; 'restore' adds its value in MW back to reactor capacity while online.",
            "properties": {
              "type": {
                "enum": [
                  "slow",
                  "reveal",
                  "damp",
                  "restore"
                ]
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "fx": {
            "type": "object",
            "required": [
              "class",
              "colour"
            ],
            "additionalProperties": false,
            "description": "Presentation-only projectile/effect language for the combat FX layer (scripts/combat_fx.gd, scripts/fx_additive.gd). Never read by sim/engine.py or anchor_sim.gd — changing it cannot change a rule. Optional: a tower with no fx block draws with the FX layer's default. 'bolt' travels with real speed and leads its target; 'arc' is an instant chained lightning polyline; 'beam' charges up then snaps out full length; 'flak' is a travelling shell that airbursts at the tower's own splash radius; 'mortar' lobs a shell on a parabola to a ground burst; 'field' fires nothing and instead draws a slow pulse ring at the tower's range, for zero-damage support emplacements.",
            "properties": {
              "class": {
                "enum": [
                  "bolt",
                  "arc",
                  "beam",
                  "flak",
                  "mortar",
                  "field"
                ]
              },
              "colour": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "outer/glow colour, sRGB hex"
              },
              "core": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "bright core colour, sRGB hex. Defaults to near-white if absent."
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "tiles/sec of travel, for classes with real travel time (bolt, flak, mortar)"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "stroke width in px, at 1x zoom"
              },
              "trail": {
                "type": "number",
                "minimum": 0,
                "description": "seconds of fading after-image behind a travelling projectile"
              }
            }
          },
          "upgrade": {
            "type": "object",
            "required": [
              "cost"
            ],
            "additionalProperties": false,
            "description": "optional second tier bought in place. Any stat named here replaces the base value; 'cost' is what the upgrade itself costs.",
            "properties": {
              "cost": {
                "type": "integer",
                "minimum": 1
              },
              "draw_mw": {
                "type": "number",
                "minimum": 0
              },
              "damage": {
                "type": "number",
                "minimum": 0
              },
              "range": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fire_interval": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "splash": {
                "type": "number",
                "minimum": 0
              },
              "effect": {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "description": "non-damage role. 'slow' scales enemy speed in range; 'reveal' makes air units targetable; 'damp' suppresses that fraction of a covered unit's bus drain; 'restore' adds its value in MW back to reactor capacity while online.",
                "properties": {
                  "type": {
                    "enum": [
                      "slow",
                      "reveal",
                      "damp",
                      "restore"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
