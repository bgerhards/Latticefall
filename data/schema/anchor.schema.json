{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anchor (level) definition",
  "type": "object",
  "required": [
    "schema",
    "id",
    "act",
    "title",
    "capacity_mw",
    "starting_funds",
    "grid",
    "path",
    "slots",
    "waves"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "anchor"
    },
    "id": {
      "type": "string",
      "pattern": "^anchor-\\d{2}$"
    },
    "act": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "title": {
      "type": "string"
    },
    "capacity_mw": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "fixed. raised only by story beats."
    },
    "starting_funds": {
      "type": "integer",
      "minimum": 0
    },
    "lives": {
      "type": "integer",
      "minimum": 1
    },
    "grid": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 4
        },
        "h": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spawns"
        ],
        "additionalProperties": false,
        "properties": {
          "lead_in": {
            "type": "number",
            "minimum": 0,
            "description": "seconds before first spawn"
          },
          "spawns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "enemy",
                "count"
              ],
              "additionalProperties": false,
              "properties": {
                "enemy": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "interval": {
                  "type": "number",
                  "minimum": 0
                },
                "delay": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "tutorial": {
      "type": "boolean",
      "description": "relaxes the multiple-viable-builds requirement. Only legitimate while few emplacements are unlocked."
    }
  }
}
