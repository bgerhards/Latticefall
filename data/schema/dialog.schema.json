{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anchor dialog",
  "type": "object",
  "required": ["schema", "anchor", "lines"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "dialog"},
    "anchor": {"type": "string", "pattern": "^anchor-\\d{2}$"},
    "lines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["trigger", "speaker", "text"], "additionalProperties": false,
        "properties": {
          "trigger": {"type": "string",
            "pattern": "^(brief|debrief|wave-start:\\d+|wave-clear:\\d+|brownout|first-leak|low-lives|surge-first|surge-ready|overcharge-first|shutter-first|wards-half|wards-full|wave-called|chain-high|recovery-taken)$"},
          "speaker": {"enum": ["vasquez", "okonkwo", "control", "ferrar"]},
          "text": {"type": "string", "minLength": 1},
          "beat": {"type": "string", "description": "stage direction, not shown"},
          "critical": {"const": false,
            "description": "mid-wave lines are interruptible, so no line may be critical"}
        }
      }
    }
  }
}
