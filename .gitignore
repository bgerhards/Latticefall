# Godot 4+ specific ignores
.godot/
/android/

# macOS
.DS_Store

# Blender
*.blend1
*.blend2

# Build / export output
/build/
/export/

# Render scratch (intermediates; final atlases are committed)
/assets/renders/_scratch/

# Python virtualenv
.venv/
__pycache__/
*.pyc

# Gate reports written by the pre-commit/pre-push hooks (tools/hooks/, PRC-08) — local
# scratch, not build output anyone commits.
/.cache/
/gate.json
/gate.md
/gate-tier4.json
/gate-tier4.md

# Music masters live outside the repo (see assets/audio/music_manifest.json
# for their sha256). Only the encoded Ogg is versioned.
assets/audio/source/

# loop-check scratch clips
assets/audio/_loop_checks/

# Agent worktrees — a git worktree inside the repo is not repo content
.claude/worktrees/

# Godot import sidecars for the LOOSE sprite renders (LF-165).
#
# The game never loads a loose render: scripts/sprites.gd reads assets/renders/sprites.json
# and the two packed atlas pages, and nothing else. The 570 per-render PNGs are intermediate
# build output, so the .import sidecar the editor writes next to each one is bookkeeping about
# build output — regenerated on any import, and carrying no content.
#
# They were tracked inconsistently: 570 render PNGs, 224 tracked sidecars, and 360 more sitting
# untracked in every agent's `git status`, which made `git status --porcelain | grep -v import`
# a reflex. They were also load-bearing by accident until wrap_gate.py started ignoring them by
# suffix — the session wrap escalated to tier 4 on every invocation because of this litter.
#
# The atlas pages' sidecars ARE kept: those two PNGs are what the engine actually imports.
assets/renders/**/*.png.import
!assets/renders/atlas/*.png.import

report-202*-*

# /insights output and anything written to reason about it. The owner's call, 2026-08-01: the
# reports are a snapshot of a sampling window and go stale, whereas the commits are the
# permanent record — so they stay on disk for local review and out of the repository. Ignoring
# the directory (not just the reports) also keeps it out of every agent's `git status`, the
# same litter problem the `.import` block above exists for.
docs/insights/
